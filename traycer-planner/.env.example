# Copy to .env (never commit .env). Only the variables below are read.

# Provider: gemini | ollama. Default: gemini if an API key is set, otherwise ollama.
# XPLAN_PROVIDER=ollama
# XPLAN_MODEL=

# Gemini (cloud)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Ollama (local)
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_MODEL=qwen3
# OLLAMA_NUM_CTX=16384
# OLLAMA_KEEP_ALIVE=10m
